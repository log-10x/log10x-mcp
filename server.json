{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.log-10x/log10x-mcp",
  "title": "Log10x MCP",
  "description": "Rank log patterns by volume and cost, then compact, tier down or offload the excess over each cap",
  "repository": {
    "url": "https://github.com/log-10x/log10x-mcp",
    "source": "github"
  },
  "websiteUrl": "https://doc.log10x.com/apps/mcp/",
  "icons": [
    {
      "src": "https://doc.log10x.com/assets/favicon-512x512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://doc.log10x.com/assets/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "version": "1.30.93",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "log10x-mcp",
      "version": "1.30.93",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LOG10X_API_KEY",
          "description": "Log10x API key. Without it the server boots read-only against the public demo dataset.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
